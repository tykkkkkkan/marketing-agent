# 复制本文件为 .env 并填入真实值（docker compose 会自动读取本目录的 .env）
#
# 数据关联：本服务通过同一个 MySQL 实例（ZT-agent 的 agent_db）只读消费业务数据。
# 本地开发若 MySQL 就在本机，用 127.0.0.1 即可；容器内连接宿主机 MySQL 用 host.docker.internal。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=agent_db
DB_PASSWORD=

# 与 ZT-agent 共用同一个 DeepSeek 密钥
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 运营执行层：让 Agent 能真实「办事」（补货 / 发货 / 售后）──────────
# 营销 Agent 不直接改 ZT-agent 的数据库，而是以「一个后台操作员」的身份调用
# ZT-agent 自己的管理接口，由 ZT-agent 保障库存扣减、订单状态机与钱包记账的事务一致性。
ZT_AGENT_BASE_URL=http://127.0.0.1:8000

# ZT-agent 的 staff（管理员）账号——用于换取 JWT 调用管理接口。
# 建议在 ZT-agent 后台 (http://localhost:8001/admin/) 为营销 Agent **单独建一个
# 机器人账号**（is_staff=True），而不是复用超级管理员：
#   · 最小权限、可随时停用；· 审计日志能区分「人操作」和「Agent 操作」。
ZT_STAFF_USER=
ZT_STAFF_PASSWORD=

# 执行模式：
#   live    = 真实执行（会产生真实的库存/订单变更）
#   dry_run = 演练模式（只生成「将要发起的请求」，不落地任何业务变更）
MKT_EXECUTE_MODE=live

# 调用 ZT-agent 的超时时间（秒）
ZT_AGENT_TIMEOUT=20

# ── 自动运营（无人值守）────────────────────────────────────────────
# 自动运营本身是「默认关闭」的：真正决定它开不开的是页面策略项
# autopilot_enabled（默认 off）。这里的环境变量只是**总闸**，用于运维场景
# 一次性停用整个调度器（例如排障、迁移、不希望容器后台跑定时任务时）。
#
#   留空 / 不写 = 调度器正常随服务启动（仍需页面开启才会真正干活）
#   1 / true / on / yes = 强制不启动调度器，页面上的开关也会无效
#
# AUTOPILOT_DISABLED=
